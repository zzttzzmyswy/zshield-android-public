# Effectiveness measurement working data (M5a). The *reports* live in `docs/`; the downloaded filter
# lists (68 MB), the raw JSON and the screenshots are regenerated by `scripts/effectiveness/run.sh`
# and must not enter the repository — a 68 MB list snapshot in git would be stale the next day and
# would dominate the clone.
.effectiveness/

# Python bytecode from the effectiveness scripts (scripts/effectiveness/*.py).
__pycache__/

# jsdom, installed on demand for scripts/check-procedural-runtime.mjs (docs/TESTING.md §12.2b).
node_modules/

# MYS-2826 cost-profile run artifacts. The *report* is `docs/reviews/i2-edits-cost.md`; the raw JSON,
# the profile data and the per-run logs are regenerated by `scripts/perf/run.sh` and must not enter the
# repository (they carry absolute paths from the machine that produced them).
.perf-run/

# MYS-2826 measurement bundle (built by scripts/perf/run.sh, delivered as an attachment).
.effectiveness/binaries/

# Gradle/Kotlin compiler session state, written on every build.
.kotlin/

# A contributor's throwaway signing key (`ZSHIELD_KEYSTORE_DIR=$PWD/.local-signing`, see
# CONTRIBUTING.md). Signing material never enters the repository.
.local-signing/
